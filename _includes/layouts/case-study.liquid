      </svg>
      <img class="back-avatar" src="/avatar.webp" alt="" width="24" height="24">
      <span>Home</span>
    </a>
  </nav>

  <header class="case-intro">
    <div class="case-title-block">
      <h1 class="case-title">{{ title }}</h1>
      <p class="case-meta">{{ employer }} · {{ year }}</p>
    </div>
    <p class="case-lead">{{ lead }}</p>
  </header>

  <div class="case-body">
    {{ content }}
  </div>

  {% include "footer.liquid" %}
</main>
<dialog id="lightbox" class="lightbox" closedby="any" aria-label="Lightbox">
  <div class="lightbox-stage">
    <figure class="lightbox-figure">
      <div class="lightbox-media-slot"></div>
      <figcaption class="lightbox-caption" hidden></figcaption>
    </figure>
  </div>
  <div class="lightbox-counter" aria-live="polite"></div>
  <button class="lightbox-btn lightbox-close" type="button" commandfor="lightbox" command="close" aria-label="Close" autofocus>
